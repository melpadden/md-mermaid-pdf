{
  "name": "@paddentech/md-mermaid-pdf",
  "version": "0.1.0",
  "description": "Render GitHub-flavoured Markdown with Mermaid diagrams to PDF.",
  "type": "module",
  "bin": {
    "md-mermaid-pdf": "src/cli.js"
  },
  "exports": {
    ".": "./src/index.js"
  },
  "files": [
    "src/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "render:sample": "node ./src/cli.js ./samples/example.md ./samples/example.pdf",
    "test": "node --test test/smoke.test.js",
    "lint": "eslint src/ test/",
    "typecheck": "tsc"
  },
  "keywords": [
    "markdown",
    "mermaid",
    "pdf",
    "github"
  ],
  "author": "Mel Padden <melpadden@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/melpadden/md-mermaid-pdf.git"
  },
  "homepage": "https://github.com/melpadden/md-mermaid-pdf#readme",
  "bugs": {
    "url": "https://github.com/melpadden/md-mermaid-pdf/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "github-markdown-css": "^5.8.1",
    "highlight.js": "^11.11.1",
    "markdown-it": "^14.1.0",
    "markdown-it-anchor": "^9.2.0",
    "markdown-it-task-lists": "^2.1.1",
    "mermaid": "^11.12.0",
    "pdf-lib": "^1.17.1",
    "playwright": "^1.56.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^25.9.0",
    "eslint": "^9.0.0",
    "typescript": "^5.0.0"
  }
}
